# Copy to .env and fill in values (never commit .env with secrets)

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=autoassist
PORT=3002
NODE_ENV=development

# --- Quotation → WhatsApp notify (at least one provider) ---

# Option A: Twilio WhatsApp API (current backend implementation)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio sandbox sender by default
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Recipient in E.164 format with + (example: +60122846084)
WHATSAPP_NOTIFY_PHONE=+60162369283,+60122846084

# Optional: Twilio Content Template SID — only used if plain-text send is rejected
# (e.g. outside the 24h messaging window). Template body must include {{1}}–{{8}}
# for ref, vehicle, workshop, type, amount, engine, chassis, notes.
# TWILIO_QUOTATION_TEMPLATE_SID=HXxxxxxxxx
# TWILIO_WHATSAPP_TEMPLATE_SID=HXxxxxxxxx
